{
  "name": "senzor-core",
  "version": "1.0.0",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "generateFirebaseEnvChunks": "ts-node-dev --transpile-only src/scripts/generateChunks.ts",
    "lint": "eslint src/**/*.ts",
    "start:server": "node --import ./dist/utils/otlp.js dist/server/index.js",
    "start:worker": "node dist/worker/index.js",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker/index.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:worker\" --names \"API,WORKER\" --prefix-colors \"yellow,blue\"",
    "start": "concurrently \"npm run start:server\" \"npm run start:worker\" --names \"API,WORKER\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@senzops/apm-node": "^1.3.1",
    "@types/node-cron": "^3.0.11",
    "@types/ua-parser-js": "^0.7.39",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^11.11.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "resend": "^6.9.4",
    "socket.io": "^4.8.3",
    "ua-parser-js": "^2.0.6",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.4",
    "concurrently": "^9.2.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
